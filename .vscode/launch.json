{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: API",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "cwd": "${workspaceFolder}",
      "env": {
        "HTTP_ADDR": ":8080",
        "DEBUG": "true"
      }
    },
    {
      "name": "Web: Chrome (先运行 make dev-web)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    }
  ]
}